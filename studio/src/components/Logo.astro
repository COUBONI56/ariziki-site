---
/** Logo : mot-symbole ARIZIKI + sous-marque, dans un cartouche doré (même famille que le logo EliteOffers). */
import { site } from '../config/site';
interface Props { class?: string; size?: 'sm' | 'lg' }
const { class: className = '', size = 'sm' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <span class="logo__word">{site.wordmark}</span>
  {site.subBrand && <span class="logo__sub">{site.subBrand}</span>}
</span>

<style>
  .logo {
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.3em;
    padding: 0.5em 0.85em 0.42em;
    border: 1.5px solid rgb(var(--color-accent-rgb) / 0.85);
    border-radius: 6px; line-height: 1;
  }
  .logo--sm { font-size: 1rem; }
  .logo--lg { font-size: 1.25rem; }
  .logo__word, .logo__sub {
    font-family: var(--font-brand); font-weight: 700;
    background: linear-gradient(180deg, var(--color-accent-light) 0%, var(--color-accent) 55%, #b8922a 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .logo__word { letter-spacing: 0.18em; margin-right: -0.18em; }
  .logo__sub { font-size: 0.5em; letter-spacing: 0.36em; margin-right: -0.36em; text-transform: uppercase; }
</style>
