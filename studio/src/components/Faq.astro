---
/** Questions fréquentes : accordéons natifs <details> (accessibles, sans JavaScript). */
import SectionHead from './SectionHead.astro';
import { home } from '../content/home';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const f = home[lang].faq;
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: f.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---

<section class="faq section theme-cream" id="faq" data-nav-theme="light" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <SectionHead eyebrow={f.eyebrow} title={f.title} id="faq-title" />
    <div class="faq__list">
      {f.items.map((it) => (
        <details class="faq__item" data-reveal>
          <summary><span>{it.q}</span><i aria-hidden="true"></i></summary>
          <p class="muted">{it.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px clamp(48px, 8vw, 128px); align-items: start; }
  .faq__list { border-top: 1px solid var(--color-fog-border); }
  .faq__item { border-bottom: 1px solid var(--color-fog-border); }
  .faq__item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; font-size: 1.125rem; font-weight: 500; letter-spacing: -0.005em; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary i { position: relative; width: 14px; height: 14px; flex: none; }
  .faq__item summary i::before, .faq__item summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transition: transform 400ms var(--ease-out); }
  .faq__item summary i::after { transform: rotate(90deg); }
  .faq__item[open] summary i::after { transform: rotate(0deg); }
  .faq__item p { padding: 0 48px 24px 0; max-width: 60ch; }
  @media (max-width: 900px) { .faq__grid { grid-template-columns: 1fr; } }
</style>
