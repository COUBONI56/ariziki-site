---
/**
 * En-tête des pages intérieures : même ADN que le hero d'accueil
 * (ciel étoilé, horizon doré, titres qui sortent de leurs masques),
 * en plus compact. Emplacements : « actions » et « visual » (optionnels).
 */
import Horizon from './Horizon.astro';
interface Props { eyebrow: string; title: string[]; lead?: string; compact?: boolean }
const { eyebrow, title, lead, compact = false } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class:list={['phero theme-dark', { 'phero--compact': compact, 'phero--split': hasVisual }]} id="top" data-hero data-nav-theme="dark" aria-labelledby="page-title">
  <div class="hero__sky" aria-hidden="true">
    <canvas class="phero__stars" data-stars></canvas>
    <Horizon class="phero__horizon" data-planet />
    <div class="phero__veil" data-hero-veil></div>
  </div>

  <div class="phero__inner container" data-hero-content>
    <div class="phero__text">
      <p class="eyebrow" data-hero-hide data-hero-item>{eyebrow}</p>
      <h1 class="phero__title" id="page-title" data-hero-title>
        {title.map((line) => <span class="mask"><span class="mask__inner">{line}</span></span>)}
      </h1>
      {lead && <p class="lead phero__lead" data-hero-hide data-hero-item>{lead}</p>}
      {Astro.slots.has('actions') && <div class="phero__actions" data-hero-hide data-hero-item><slot name="actions" /></div>}
    </div>
    {hasVisual && <div class="phero__visual" data-hero-hide data-hero-item><slot name="visual" /></div>}
  </div>
</section>

<style>
  .phero {
    position: relative; isolation: isolate; overflow: clip;
    min-height: 82vh; min-height: 82svh;
    display: flex; align-items: center;
    background: var(--color-night);
    padding-block: calc(var(--nav-h) + 56px) clamp(96px, 14vh, 160px);
  }
  .phero--compact { min-height: 0; padding-block: calc(var(--nav-h) + 64px) 96px; }
  .hero__sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .phero__stars { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.8; }
  .phero :global(.phero__horizon) { top: 90%; width: max(160vw, 1600px); }
  .phero--compact :global(.phero__horizon) { top: 94%; }
  .phero__veil { position: absolute; inset: 0; background: #000; opacity: 0; }

  .phero__inner { position: relative; display: grid; gap: 48px; align-items: center; }
  .phero--split .phero__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
  .phero__text { display: grid; justify-items: start; gap: 24px; }
  .phero__title {
    font-size: clamp(2.75rem, 1.3rem + 5.2vw, 6rem); line-height: 0.96; letter-spacing: var(--ls-display); font-weight: 300;
  }
  .phero--compact .phero__title { font-size: clamp(2.5rem, 1.4rem + 3.6vw, 4.5rem); }
  .phero__lead { color: rgb(255 255 255 / 0.72); max-width: 36rem; }
  .phero__actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 8px; }
  .phero__visual {
    position: relative; min-height: 420px; border-radius: var(--r-container);
    background: radial-gradient(80% 70% at 60% 40%, rgb(var(--color-accent-rgb) / 0.08), transparent 70%), linear-gradient(180deg, #131312, #0b0b0c);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    padding: clamp(20px, 3vw, 40px);
  }

  @media (max-width: 900px) {
    .phero { min-height: 0; }
    .phero--split .phero__inner { grid-template-columns: 1fr; }
    .phero__visual { min-height: 340px; }
    .phero :global(.phero__horizon) { top: 95%; width: max(260vw, 1000px); }
  }
</style>
