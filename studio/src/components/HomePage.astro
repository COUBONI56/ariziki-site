---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import Principles from './Principles.astro';
import Ecosystem from './Ecosystem.astro';
import Audience from './Audience.astro';
import Offers from './Offers.astro';
import Method from './Method.astro';
import Faq from './Faq.astro';
import CtaFinal from './CtaFinal.astro';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---

<Base lang={lang} intro>
  <Hero lang={lang} />
  <Manifesto lang={lang} />
  <Audience lang={lang} />
  <Principles lang={lang} />
  <Ecosystem lang={lang} />
  <Offers lang={lang} />
  <Method lang={lang} />
  <Faq lang={lang} />
  <CtaFinal lang={lang} />
</Base>
