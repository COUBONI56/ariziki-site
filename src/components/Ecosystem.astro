---
import { home } from '../content/home';
import { products, productName } from '../content/products';
import { route } from '../i18n/routes';
import VisualPipeline from './visuals/VisualPipeline.astro';
import VisualOffers from './visuals/VisualOffers.astro';
import VisualDashboard from './visuals/VisualDashboard.astro';
import VisualOrbit from './visuals/VisualOrbit.astro';
import VisualStudio from './visuals/VisualStudio.astro';
import ProductMark from './ProductMark.astro';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const e = home[lang].ecosystem;
const visuals = { offers: VisualOffers, pipeline: VisualPipeline, dashboard: VisualDashboard, orbit: VisualOrbit, studio: VisualStudio };
---

<section class="eco section theme-dark" id="ecosysteme" data-nav-theme="dark" aria-labelledby="eco-title">
  <div class="container">
    <header class="eco__head">
      <p class="eyebrow" data-reveal>{e.eyebrow}</p>
      <h2 class="h-lg eco__title" id="eco-title" data-split>
        {e.title.map((l) => <span class="mask"><span class="mask__inner">{l}</span></span>)}
      </h2>
      <p class="lead eco__lead" data-reveal>{e.lead}</p>
    </header>

    <div class="eco__stack" data-stack>
      {products.map((p) => {
        const Visual = visuals[p.visual];
        const t = p.text[lang];
        const name = productName(p, lang);
        const live = p.status === 'live' && p.url;
        const href = live ? p.url : `${route(lang, 'contact')}?subject=${p.slug}`;
        const pageHref = p.status !== 'soon' && !p.external ? route(lang, 'product', p.slug) : undefined;
        return (
          <article class:list={['pcard', `is-${p.status}`]} data-pcard aria-labelledby={`p-${p.slug}`}>
            <div class="pcard__inner">
              <div class="pcard__text">
                <div class="pcard__meta">
                  <span class="pcard__index">{p.index}</span>
                  <span class="pcard__status"><i></i>{t.status}</span>
                </div>
                {p.mark
                  ? <h3 class="pcard__name pcard__name--mark" id={`p-${p.slug}`}><span class="sr-only">{name}</span><ProductMark word={p.mark.word} sub={p.mark.sub} /></h3>
                  : <h3 class="pcard__name h-sm" id={`p-${p.slug}`}>{name}</h3>}
                <p class="pcard__tagline">{t.tagline}</p>
                <p class="pcard__desc">{t.description}</p>
                <ul class="pcard__tags">
                  {t.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <a class:list={['btn', 'pcard__cta', { 'pcard__cta--ghost': !live }]} href={href} data-magnetic {...(live ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="btn__label">{live ? `${e.visit} ${name}` : e.notify}</span>
                  <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">{live ? <path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.4"/> : <path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/>}</svg>
                </a>
                {pageHref && <a class="link-ghost pcard__more" href={pageHref}>{e.more} <span class="arrow" aria-hidden="true">→</span></a>}
              </div>
              <div class="pcard__visual" data-pcard-visual>
                <Visual lang={lang} />
              </div>
            </div>
            <div class="pcard__shade" data-pcard-shade aria-hidden="true"></div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .eco__head { display: grid; grid-template-columns: 1fr minmax(0, 26rem); grid-template-areas: 'eb eb' 'title lead'; align-items: end; gap: 24px 64px; margin-bottom: clamp(48px, 7vw, 96px); }
  .eco__head .eyebrow { grid-area: eb; }
  .eco__title { grid-area: title; }
  .eco__lead { grid-area: lead; }

  .eco__stack { display: grid; gap: 24px; }
  .pcard {
    --top: calc(var(--nav-h) + 20px);
    position: sticky; top: var(--top);
    min-height: min(620px, calc(100svh - var(--top) - 32px));
    border-radius: var(--r-container);
    background:
      radial-gradient(90% 70% at 85% 50%, rgb(var(--color-accent-rgb) / 0.07) 0%, transparent 60%),
      linear-gradient(180deg, #131312 0%, #0b0b0c 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    overflow: clip;
    transform-origin: 50% 0%;
    will-change: transform;
  }
  .pcard__inner { position: relative; height: 100%; min-height: inherit; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .pcard__text { padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .pcard__meta { display: flex; align-items: center; gap: 16px; margin-bottom: clamp(28px, 4vw, 48px); }
  .pcard__index { font-size: var(--fs-caption); color: var(--color-stone); font-variant-numeric: tabular-nums; }
  .pcard__status { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-label); font-weight: 700; letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--color-stone); }
  .pcard__status i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 10px var(--color-accent); }
  .is-live .pcard__status { color: var(--color-accent-light); }
  .is-building .pcard__status i { background: transparent; border: 1px solid var(--color-accent); box-shadow: none; animation: blink 1.6s ease-in-out infinite; }
  .is-soon .pcard__status i { background: transparent; border: 1px solid var(--color-stone); box-shadow: none; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .pcard__name { color: var(--color-paper); }
  .pcard__name--mark { font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem); line-height: 1; margin-block: 2px 4px; }
  .pcard__tagline { margin-top: 14px; font-size: var(--fs-body-lg); font-weight: 500; color: var(--color-paper); letter-spacing: -0.005em; max-width: 34ch; }
  .pcard__desc { margin-top: 12px; color: var(--color-stone); max-width: 44ch; }
  .pcard__tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 32px; }
  .pcard__tags li { font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.04em; padding: 5px 11px; border-radius: var(--r-sm); background: #1c1c1e; color: #c9c8cc; }
  .pcard__text :global(.btn) + .pcard__more { margin-top: 18px; color: var(--color-stone); }
  .pcard__more:hover { color: var(--color-paper); }
  .pcard__cta--ghost { --btn-bg: transparent; --btn-fg: var(--color-paper); --btn-hover: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22); }
  .pcard__visual { position: relative; min-height: 340px; border-left: 1px solid rgb(255 255 255 / 0.05); padding: clamp(20px, 3vw, 40px); }
  .pcard__shade { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }

  @media (max-width: 900px) {
    .eco__head { grid-template-columns: 1fr; grid-template-areas: 'eb' 'title' 'lead'; }
    .pcard { position: relative; top: auto; min-height: 0; }
    .pcard__inner { grid-template-columns: 1fr; }
    .pcard__visual { order: -1; min-height: 320px; border-left: 0; border-bottom: 1px solid rgb(255 255 255 / 0.05); }
  }
</style>
