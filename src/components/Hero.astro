---
import Horizon from './Horizon.astro';
import { home } from '../content/home';
import { products, productName } from '../content/products';
import { route } from '../i18n/routes';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const h = home[lang].hero;
const chips = products.filter((p) => p.status !== 'soon');
---

<section class="hero theme-dark" id="top" data-hero data-hero-pin data-nav-theme="dark" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true">
    <canvas class="hero__stars" data-stars></canvas>
    <Horizon class="hero__horizon" data-planet />
    <div class="hero__veil" data-hero-veil></div>
  </div>

  <div class="hero__content container" data-hero-content>
    <p class="eyebrow hero__eyebrow" data-hero-hide data-hero-item>{h.eyebrow}</p>

    <h1 class="display hero__title" id="hero-title" data-hero-title>
      {h.title.map((line) => (
        <span class="mask"><span class="mask__inner">{line}</span></span>
      ))}
    </h1>

    <div class="hero__bottom">
      <p class="lead hero__lead" data-hero-hide data-hero-item>{h.lead}</p>
      <div class="hero__actions" data-hero-hide data-hero-item>
        <a class="btn" href={h.primary.href} data-magnetic>
          <span class="btn__label">{h.primary.label}</span>
          <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
        <a class="link-ghost" href={route(lang, 'contact')}>{h.secondary.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="hero__foot container" data-hero-hide data-hero-item>
    <ul class="hero__products">
      {chips.map((p) => (
        <li>
          <a class:list={['hero__product', `is-${p.status}`]} href={route(lang, 'product', p.slug)}>
            <i aria-hidden="true"></i>{productName(p, lang)}{p.status !== 'live' && <span class="hero__product-status"> · {p.text[lang].status}</span>}
          </a>
        </li>
      ))}
      <li><span class="hero__product is-soon">{h.soonChip}</span></li>
    </ul>
    <span class="hero__scroll" aria-hidden="true">{h.scrollLabel}<i></i></span>
  </div>
</section>

<style>
  .hero {
    position: relative; z-index: 0;
    min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-rows: 1fr auto;
    background: var(--color-night);
    overflow: clip; isolation: isolate;
  }
  .hero__sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__stars { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.9; }
  .hero :global(.hero__horizon) { top: 74%; width: max(150vw, 1500px); }
  .hero__veil { position: absolute; inset: 0; background: #000; opacity: 0; }

  .hero__content {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(40px, 8vh, 112px));
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .hero__eyebrow { margin-bottom: clamp(20px, 3vh, 32px); }
  .hero__title { font-size: min(var(--fs-display), 12.5vh); }
  .hero__title .mask__inner { will-change: transform; }

  .hero__bottom {
    margin-top: clamp(28px, 5vh, 56px); width: 100%;
    display: grid; grid-template-columns: minmax(0, 34rem) auto; align-items: end; justify-content: space-between; gap: 28px 64px;
  }
  .hero__lead { color: rgb(255 255 255 / 0.72); max-width: 34rem; text-shadow: 0 1px 24px rgb(0 0 0 / 0.6); }
  .hero__actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }

  .hero__foot {
    position: relative;
    display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-block: 28px clamp(24px, 4vh, 40px);
  }
  .hero__products { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero__product {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.04em;
    padding: 6px 12px; border-radius: var(--r-pill);
    border: 1px solid var(--color-steel-border); color: var(--color-paper);
    background: rgb(255 255 255 / 0.03); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: border-color var(--dur-fast), background-color var(--dur-fast);
  }
  a.hero__product:hover { border-color: rgb(var(--color-accent-rgb) / 0.6); background: rgb(var(--color-accent-rgb) / 0.08); }
  .hero__product i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 8px var(--color-accent); }
  .hero__product.is-building i { background: transparent; border: 1px solid var(--color-accent); box-shadow: none; }
  .hero__product.is-soon { color: var(--color-stone); border-style: dashed; }
  .hero__product-status { color: var(--color-stone); }
  .hero__scroll {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: var(--fs-label); font-weight: 700; letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--color-stone);
  }
  .hero__scroll i { position: relative; width: 1px; height: 36px; background: var(--color-steel-border); overflow: hidden; }
  .hero__scroll i::after {
    content: ''; position: absolute; inset: 0; background: var(--color-accent);
    transform: translateY(-100%); animation: drip 2.2s var(--ease-in-out) infinite;
  }
  @keyframes drip { 0% { transform: translateY(-100%); } 55%, 100% { transform: translateY(100%); } }

  @media (max-width: 900px) {
    .hero__bottom { grid-template-columns: 1fr; }
    .hero :global(.hero__horizon) { top: 87%; width: max(240vw, 1100px); }
    .hero__title { font-size: var(--fs-display); }
    .hero__scroll { display: none; }
  }
</style>
