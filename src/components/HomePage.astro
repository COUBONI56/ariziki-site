---
/** Page d'accueil complète — rendue dans chaque langue par src/pages/. */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import Ecosystem from './Ecosystem.astro';
import Method from './Method.astro';
import Principles from './Principles.astro';
import CtaFinal from './CtaFinal.astro';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
---

<Base lang={lang} intro>
  <Hero lang={lang} />
  <Manifesto lang={lang} />
  <Ecosystem lang={lang} />
  <Method lang={lang} />
  <Principles lang={lang} />
  <CtaFinal lang={lang} />
</Base>
