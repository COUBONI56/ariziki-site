---
import { home } from '../content/home';
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const p = home[lang].principles;

// Icônes linéaires minimalistes (monochromes, 1.5px)
const icons: Record<string, string> = {
  simple: '<path d="M4 12h16" /><circle cx="12" cy="12" r="8.5" />',
  speed: '<path d="M12 4a8.5 8.5 0 1 0 8.5 8.5" /><path d="M12 12l5-5" /><path d="M17 4h3.5v3.5" />',
  shield: '<path d="M12 3.5l7 3v5.2c0 4.3-3 7.7-7 8.8-4-1.1-7-4.5-7-8.8V6.5l7-3z" /><path d="M9 12l2.2 2.2L15.5 10" />',
  people: '<circle cx="9" cy="9" r="3" /><circle cx="16.5" cy="10" r="2.4" /><path d="M3.5 19c.6-3 2.9-4.8 5.5-4.8s4.9 1.8 5.5 4.8" /><path d="M14.5 15.2c.6-.3 1.3-.4 2-.4 2 0 3.6 1.3 4 4.2" />',
};
---

<section class="principles section theme-paper" id="principes" data-nav-theme="light" aria-labelledby="principles-title">
  <div class="container">
    <header class="principles__head">
      <p class="eyebrow" data-reveal>{p.eyebrow}</p>
      <h2 class="h-lg" id="principles-title" data-split>
        {p.title.map((l) => <span class="mask"><span class="mask__inner">{l}</span></span>)}
      </h2>
    </header>

    <ul class="principles__grid" data-cards>
      {p.items.map((item, i) => (
        <li class="pcell" data-card>
          <div class="pcell__top">
            <span class="pcell__icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]} />
            </span>
            <span class="pcell__n">0{i + 1}</span>
          </div>
          <h3 class="pcell__title">{item.title}</h3>
          <p class="muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .principles__head { display: grid; gap: 24px; justify-items: start; margin-bottom: clamp(48px, 6vw, 80px); }
  .principles__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .pcell {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    min-height: 300px; padding: 28px;
    background: var(--color-cream); border: 1px solid var(--color-fog-border); border-radius: var(--r-card);
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out), background-color 500ms var(--ease-out);
  }
  .pcell:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--color-paper); }
  .pcell__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: auto; padding-bottom: 48px; }
  .pcell__icon {
    width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-paper); border: 1px solid var(--color-fog-border);
    transition: background-color 400ms var(--ease-out), color 400ms var(--ease-out), border-color 400ms var(--ease-out);
  }
  .pcell:hover .pcell__icon { background: var(--color-obsidian); color: var(--color-paper); border-color: var(--color-obsidian); }
  .pcell__n { font-size: var(--fs-caption); color: var(--color-graphite); font-variant-numeric: tabular-nums; }
  .pcell__title { font-size: var(--fs-sub); font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }

  @media (max-width: 1100px) { .principles__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .principles__grid { grid-template-columns: 1fr; } .pcell { min-height: 0; } .pcell__top { padding-bottom: 28px; } }
</style>
