---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import CtaFinal from '../CtaFinal.astro';
import { about } from '../../content/about';
import { home } from '../../content/home';
import { ui } from '../../i18n/ui';
import { products, productName } from '../../content/products';
import { site } from '../../config/site';
import { route, alternatesFor } from '../../i18n/routes';
import type { Locale } from '../../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const a = about[lang];
---

<Base lang={lang} title={a.seo.title} description={a.seo.description} alternates={alternatesFor('about')}>
  <PageHero eyebrow={a.hero.eyebrow} title={a.hero.title} lead={a.hero.lead}>
    <Fragment slot="actions">
      <a class="btn" href={`${route(lang, 'home')}#ecosysteme`} data-magnetic>
        <span class="btn__label">{home[lang].hero.primary.label}</span>
        <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </a>
      <a class="link-ghost" href={route(lang, 'contact')}>{ui[lang].navCta.label} <span class="arrow" aria-hidden="true">→</span></a>
    </Fragment>
  </PageHero>

  <!-- Le nom -->
  <section class="name section theme-cream" data-nav-theme="light" aria-labelledby="name-title">
    <div class="container name__grid">
      <div>
        <p class="eyebrow" data-reveal>{a.name.eyebrow}</p>
        <h2 class="name__word" id="name-title" data-split>
          <span class="mask"><span class="mask__inner">{site.name}</span></span>
        </h2>
        <p class="name__meaning h-sm" data-reveal>{a.name.meaning}</p>
      </div>
      <p class="name__text h-sm" data-words>
        {a.name.text.split(' ').map((w, i, arr) => <Fragment><span class="word">{w}</span>{i < arr.length - 1 ? ' ' : ''}</Fragment>)}
      </p>
    </div>
  </section>

  <!-- Le modèle -->
  <section class="model section theme-dark" data-nav-theme="dark" aria-labelledby="model-title">
    <div class="container">
      <SectionHead eyebrow={a.model.eyebrow} title={a.model.title} id="model-title" />
      <ol class="model__grid" data-cards>
        {a.model.items.map((it) => (
          <li class="model__card" data-card>
            <span class="model__n">{it.n}</span>
            <h3 class="model__title">{it.title}</h3>
            <p class="muted">{it.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- L'écosystème aujourd'hui -->
  <section class="today section theme-paper" data-nav-theme="light" aria-labelledby="today-title">
    <div class="container">
      <SectionHead eyebrow={a.ecosystem.eyebrow} title={a.ecosystem.title} id="today-title" />
      <ul class="today__list">
        {products.map((p) => {
          const href = p.status === 'soon' ? `${route(lang, 'contact')}?subject=next` : route(lang, 'product', p.slug);
          return (
            <li data-reveal>
              <a class="today__row" href={href}>
                <span class="today__index">{p.index}</span>
                <span class="today__name">{productName(p, lang)}</span>
                <span class:list={['today__status', `is-${p.status}`]}><i></i>{p.text[lang].status}</span>
                <span class="today__tagline">{p.text[lang].tagline}</span>
                <span class="today__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <CtaFinal lang={lang} />
</Base>

<style>
  .name__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 48px clamp(48px, 7vw, 120px); align-items: end; }
  .name__word { font-family: var(--font-brand); font-weight: 500; font-size: clamp(3.5rem, 1.5rem + 7vw, 8.5rem); line-height: 0.95; letter-spacing: 0.08em; margin-top: 24px; }
  .name__meaning { margin-top: 12px; color: var(--color-graphite); }
  .name__text { max-width: 36ch; }
  .name__text :global(.word) { display: inline-block; }

  .model__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .model__card {
    display: grid; align-content: start; gap: 12px; min-height: 280px; padding: 32px;
    border-radius: var(--r-card); background: #111112; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    transition: transform 500ms var(--ease-out), background-color 500ms var(--ease-out);
  }
  .model__card:hover { transform: translateY(-4px); background: #161617; }
  .model__n { font-size: var(--fs-caption); color: var(--color-accent-light); font-variant-numeric: tabular-nums; margin-bottom: auto; padding-bottom: 56px; }
  .model__title { font-size: var(--fs-sub); font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }

  .today__list { border-top: 1px solid var(--color-fog-border); }
  .today__row {
    display: grid; grid-template-columns: 56px minmax(0, 1.1fr) auto minmax(0, 1.4fr) 32px; align-items: center; gap: 24px;
    padding: 28px 8px; border-bottom: 1px solid var(--color-fog-border);
    transition: background-color 400ms var(--ease-out), padding 400ms var(--ease-out);
  }
  .today__row:hover { background: var(--color-cream); padding-inline: 20px; }
  .today__index { font-size: var(--fs-caption); color: var(--color-graphite); font-variant-numeric: tabular-nums; }
  .today__name { font-size: var(--fs-sub); font-weight: 400; letter-spacing: -0.01em; }
  .today__status { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-label); font-weight: 700; letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--color-graphite); }
  .today__status i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  .today__status.is-building i { background: transparent; border: 1.5px solid var(--color-accent); }
  .today__status.is-soon i { background: transparent; border: 1.5px dashed var(--color-graphite); }
  .today__tagline { color: var(--color-graphite); }
  .today__arrow { font-size: 1.25rem; transition: transform 400ms var(--ease-out); }
  .today__row:hover .today__arrow { transform: translateX(6px); }

  @media (max-width: 900px) {
    .name__grid { grid-template-columns: 1fr; }
    .model__grid { grid-template-columns: 1fr; }
    .model__card { min-height: 0; }
    .model__n { padding-bottom: 24px; }
    .today__row { grid-template-columns: 40px 1fr 24px; gap: 8px 16px; }
    .today__status, .today__tagline { grid-column: 2; }
    .today__arrow { grid-column: 3; grid-row: 1; }
  }
</style>
