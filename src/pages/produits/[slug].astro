---
import ProductPageView from '../../components/pages/ProductPageView.astro';
import { products, hasPage } from '../../content/products';

export function getStaticPaths() {
  return products.filter(hasPage).map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
---

<ProductPageView lang="fr" slug={slug!} />
