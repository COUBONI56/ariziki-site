# ─────────────────────────────────────────────────────────────
#  ariziki.com — configuration Apache / LiteSpeed (Hostinger)
# ─────────────────────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www → domaine nu
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Anciennes URL en .html → URL propres
  RewriteCond %{THE_REQUEST} \s/+(.+?)/?index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [L,R=301]
</IfModule>

# Cache : les fichiers de /_astro/ ont un nom unique → cache 1 an
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # En-têtes de sécurité
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Formulaire de contact : seul /api/contact.php est exécutable dans /api/
<IfModule mod_rewrite.c>
  RewriteRule ^api/(?!contact\.php$) - [F,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
