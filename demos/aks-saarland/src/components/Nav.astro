---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { ui } from '../i18n/ui';
import { locales, localeMeta, homePath, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const home = homePath(lang);
const href = (id: string) => `${home}#${id}`;
---

<header class="nav" data-nav data-theme="dark">
  <div class="nav__bar container">
    <a class="nav__logo" href={home} aria-label={t.a11y.home}>
      <Logo tagline={t.tagline} />
    </a>

    <nav class="nav__links" aria-label="Navigation">
      <ul>
        {t.nav.map((item) => <li><a class="nav__link" href={href(item.id)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav__right">
      <ul class="lang" aria-label={t.a11y.lang}>
        {locales.map((l) => (
          <li>
            <a class:list={['lang__link', { 'is-current': l === lang }]} href={homePath(l)} hreflang={localeMeta[l].hreflang} lang={localeMeta[l].hreflang} aria-current={l === lang ? 'true' : undefined} title={localeMeta[l].label}>{localeMeta[l].short}</a>
          </li>
        ))}
      </ul>
      <a class="nav__phone" href={site.phone.href}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor"/></svg>
        <span>{site.phone.display}</span>
      </a>
      <a class="btn nav__cta" href={href('anfrage')} data-magnetic><span class="btn__label">{t.navCta}</span></a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-menu" data-menu-toggle data-label-open={t.a11y.menuOpen} data-label-close={t.a11y.menuClose}>
        <span class="sr-only">{t.a11y.menuOpen}</span>
        <span class="nav__burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="nav-menu" data-menu hidden>
    <div class="menu__inner container">
      <ul class="menu__list">
        {[...t.nav, { id: 'anfrage', label: t.navCta }].map((item, i) => (
          <li class="menu__item">
            <a class="menu__link" href={href(item.id)}>
              <span class="menu__index">0{i + 1}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="menu__foot">
        <ul class="lang lang--menu" aria-label={t.a11y.lang}>
          {locales.map((l) => (
            <li><a class:list={['lang__link', { 'is-current': l === lang }]} href={homePath(l)} hreflang={localeMeta[l].hreflang} lang={localeMeta[l].hreflang} aria-current={l === lang ? 'true' : undefined}>{localeMeta[l].label}</a></li>
          ))}
        </ul>
        <a class="menu__contact" href={site.phone.href}>{site.phone.display}</a>
        <a class="menu__contact" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; color: var(--c-white); transition: transform 500ms var(--ease-out), color 300ms var(--ease-out); }
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-bottom: 1px solid transparent;
    transition: background-color 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }
  .nav.is-scrolled::before { -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px); }
  .nav.is-scrolled[data-theme='dark']::before { background: rgb(16 21 41 / 0.8); border-color: var(--c-line-dark); }
  .nav.is-scrolled[data-theme='light']::before { background: rgb(236 238 239 / 0.86); border-color: var(--c-line-light); }
  .nav[data-theme='light'] { color: var(--c-ink); }
  .nav.is-hidden { transform: translateY(-100%); }
  .nav.menu-open { transform: none; color: var(--c-white); }
  .nav.menu-open::before { background: transparent; border-color: transparent; backdrop-filter: none; }

  .nav__bar { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .nav__logo { position: relative; z-index: 2; }
  .nav__links ul { display: flex; gap: 30px; }
  .nav__link { position: relative; font-size: var(--fs-small); font-weight: 560; letter-spacing: 0.01em; opacity: 0.86; transition: opacity var(--dur-fast); }
  .nav__link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--c-brand); transform: scaleX(0); transform-origin: right; transition: transform 400ms var(--ease-out); }
  .nav__link:hover { opacity: 1; }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__right { display: flex; align-items: center; gap: 16px; position: relative; z-index: 2; }
  .nav__phone { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.02em; opacity: 0.9; }
  .nav__phone svg { width: 15px; height: 15px; color: var(--c-brand); }
  .nav[data-theme='light']:not(.menu-open) .nav__phone svg { color: currentColor; }
  .nav__cta { min-height: 42px; padding: 0 18px; font-size: var(--fs-small); }
  .nav[data-theme='light']:not(.menu-open) .nav__cta { --btn-bg: var(--c-ink); --btn-fg: var(--c-white); --btn-hover: var(--c-iron); }

  .lang { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: var(--r-btn); border: 1px solid var(--c-line-dark-strong); }
  .nav[data-theme='light']:not(.menu-open) .lang { border-color: var(--c-line-light); }
  .lang__link { display: block; padding: 6px 8px; border-radius: 2px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.06em; line-height: 1; opacity: 0.62; transition: opacity var(--dur-fast), background-color var(--dur-fast); }
  .lang__link:hover { opacity: 1; }
  .lang__link.is-current { opacity: 1; background: var(--c-brand); color: var(--c-night); }
  .nav[data-theme='light']:not(.menu-open) .lang__link.is-current { background: var(--c-ink); color: var(--c-white); }

  .nav__burger { display: none; width: 44px; height: 44px; place-items: center; border: 1px solid var(--c-line-dark-strong); border-radius: var(--r-btn); }
  .nav[data-theme='light']:not(.menu-open) .nav__burger { border-color: var(--c-line-light); }
  .nav__burger-lines { position: relative; width: 20px; height: 8px; }
  .nav__burger-lines i { position: absolute; left: 0; right: 0; height: 2px; background: currentColor; transition: transform 450ms var(--ease-out), top 450ms var(--ease-out); }
  .nav__burger-lines i:first-child { top: 0; }
  .nav__burger-lines i:last-child { top: 6px; }
  .menu-open .nav__burger-lines i:first-child { top: 3px; transform: rotate(45deg); }
  .menu-open .nav__burger-lines i:last-child { top: 3px; transform: rotate(-45deg); }

  .menu { position: fixed; inset: 0; z-index: 1; background: var(--c-night); color: var(--c-white); clip-path: inset(0 0 100% 0); transition: clip-path 700ms var(--ease-in-out); }
  .menu.is-open { clip-path: inset(0 0 0 0); }
  .menu__inner { height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 44px; padding-top: var(--nav-h); }
  .menu__list { display: grid; gap: 2px; }
  .menu__item { overflow: clip; border-bottom: 1px solid var(--c-line-dark); }
  .menu__link { display: flex; align-items: baseline; gap: 16px; padding-block: 12px; transform: translateY(105%); transition: transform 700ms var(--ease-out); }
  .menu.is-open .menu__link { transform: none; }
  .menu.is-open .menu__item:nth-child(2) .menu__link { transition-delay: 60ms; }
  .menu.is-open .menu__item:nth-child(3) .menu__link { transition-delay: 120ms; }
  .menu.is-open .menu__item:nth-child(4) .menu__link { transition-delay: 180ms; }
  .menu.is-open .menu__item:nth-child(5) .menu__link { transition-delay: 240ms; }
  .menu__index { font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-brand); }
  .menu__label { font-size: clamp(2.5rem, 11vw, 4rem); font-weight: 820; font-stretch: 72%; text-transform: uppercase; line-height: 0.95; }
  .menu__foot { display: grid; gap: 14px; justify-items: start; color: var(--c-stone); font-family: var(--font-mono); font-size: var(--fs-small); }
  .lang--menu .lang__link { font-size: 0.75rem; padding: 9px 12px; }

  @media (max-width: 1180px) { .nav__phone { display: none; } }
  @media (max-width: 960px) {
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: grid; }
  }
  @media (max-width: 520px) { .nav__right > .lang { display: none; } }
</style>
