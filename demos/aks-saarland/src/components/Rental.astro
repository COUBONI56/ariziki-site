---
import { rentals } from '../config/site';
import { home } from '../content/home';
import { homePath, localeMeta, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const r = home[lang].rental;
const nf = new Intl.NumberFormat(localeMeta[lang].intl, { maximumFractionDigits: 2 });
const fmt = (v: number | string) => (typeof v === 'number' ? nf.format(v) : v);
---
<section class="rental section theme-paper" id="mietpark" data-nav-theme="light" aria-labelledby="mietpark-title">
  <div class="container rental__grid">
    <div class="rental__aside">
      <div class="rental__sticky">
        <p class="eyebrow" data-reveal>{r.eyebrow}</p>
        <h2 class="h" id="mietpark-title" data-split>
          {r.title.map((l) => <span class="mask"><span class="mask__inner">{l}</span></span>)}
        </h2>
        <p class="lead" data-reveal>{r.lead}</p>

        <!-- Chargeur télescopique : la flèche se lève pendant le défilement -->
        <svg class="loader" viewBox="-40 -40 560 360" aria-hidden="true" data-loader>
          <g class="loader__body">
            <path d="M70 236L86 196H440L456 236Z" />
            <path d="M300 196V166H436L448 196" />
            <path class="thin" d="M318 176H420M318 184H420" />
            <g data-loader-boom>
              <rect x="190" y="148" width="244" height="26" rx="2" />
              <rect x="40" y="152" width="170" height="18" rx="1" />
              <circle cx="420" cy="161" r="7" />
              <g data-loader-fork>
                <rect x="22" y="128" width="16" height="64" rx="1" />
                <path d="M22 190H-36V196H22" />
              </g>
            </g>
            <path d="M150 196V104Q150 96 158 96H222Q232 96 234 106L246 196Z" />
            <path class="glass" d="M160 110H222L232 186H160Z" />
            <circle class="wheel" cx="128" cy="252" r="48" /><circle cx="128" cy="252" r="30" /><circle cx="128" cy="252" r="10" />
            <circle class="wheel" cx="390" cy="252" r="48" /><circle cx="390" cy="252" r="30" /><circle cx="390" cy="252" r="10" />
            <path class="thin" d="M-40 300H520" />
          </g>
          <rect class="loader__beacon" x="182" y="86" width="12" height="10" rx="2" />
        </svg>
      </div>
    </div>

    <ul class="rental__list">
      {rentals.map((m) => (
        <li class="machine" data-card>
          <div class="machine__head">
            <div>
              <p class="mono machine__brand">{m.brand} · {r.kinds[m.kind]}</p>
              <h3 class="machine__model h-sm">{m.model}</h3>
            </div>
            <span class="machine__tag mono">{r.price}</span>
          </div>
          <dl class="machine__specs">
            {m.specs.map((sp) => (
              <div class="spec">
                <dt class="mono">{r.specs[sp.key]}</dt>
                <dd><span class="spec__value" data-count={typeof sp.value === 'number' ? String(sp.value) : undefined}>{fmt(sp.value)}</span><span class="spec__unit">{sp.unit}</span></dd>
              </div>
            ))}
          </dl>
          <ul class="machine__features">
            {m.features.map((f) => <li>{r.features[f]}</li>)}
          </ul>
          <a class="link-line machine__cta" href={`${homePath(lang)}#anfrage`} data-prefill="rent" data-machine={m.id}>
            {r.cta}
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rental__grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(40px, 6vw, 112px); }
  .rental__sticky { position: sticky; top: calc(var(--nav-h) + 32px); display: grid; gap: 22px; }
  .loader { width: 100%; max-width: 560px; margin-top: 12px; overflow: visible; }
  .loader__body * { fill: var(--c-paper); stroke: var(--c-ink); stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .loader__body g { fill: none; stroke: none; }
  .loader__body .thin { fill: none; stroke: rgb(16 21 41 / 0.3); stroke-width: 1; }
  .loader__body .glass { fill: rgb(16 21 41 / 0.05); stroke-width: 1; }
  .loader__body .wheel { fill: var(--c-ink); }
  .loader__beacon { fill: var(--c-accent); }

  .rental__list { display: grid; gap: 16px; }
  .machine {
    display: grid; gap: 22px; padding: clamp(22px, 2.4vw, 34px);
    background: var(--c-white); border: 1px solid var(--c-line-light); border-radius: var(--r-container);
    transition: border-color 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .machine:hover { border-color: rgb(16 21 41 / 0.4); box-shadow: 0 18px 40px -24px rgb(16 21 41 / 0.35); }
  .machine__head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
  .machine__brand { color: var(--c-graphite); margin-bottom: 8px; }
  .machine__tag { flex: none; padding: 6px 10px; border: 1px solid var(--c-line-light); border-radius: var(--r-btn); color: var(--c-graphite); font-size: 0.6875rem; }
  .machine__specs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--c-line-light); }
  .spec { padding: 16px 12px 16px 0; }
  .spec + .spec { padding-left: 16px; border-left: 1px solid var(--c-line-light); }
  .spec dt { color: var(--c-graphite); font-size: 0.6875rem; }
  .spec dd { margin-top: 8px; display: flex; align-items: baseline; gap: 4px; }
  .spec__value { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem); font-weight: 820; font-stretch: 74%; line-height: 1; font-variant-numeric: tabular-nums; }
  .spec__unit { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--c-graphite); }
  .machine__features { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--fs-small); color: var(--c-graphite); }
  .machine__features li { display: inline-flex; align-items: center; gap: 8px; }
  .machine__features li::before { content: ''; width: 5px; height: 5px; background: var(--c-ink); }
  .machine__cta { justify-self: start; font-size: var(--fs-small); }

  @media (max-width: 960px) {
    .rental__grid { grid-template-columns: 1fr; }
    .rental__sticky { position: static; }
    .loader { max-width: 440px; }
  }
  @media (max-width: 520px) {
    .machine__head { flex-direction: column; }
    .spec { padding-right: 8px; }
    .spec + .spec { padding-left: 10px; }
  }
</style>
