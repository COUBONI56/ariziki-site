---
interface Props { items: readonly string[] }
const { items } = Astro.props;
---
<div class="ticker theme-dark" data-nav-theme="dark">
  <p class="sr-only">{items.join(', ')}</p>
  <div class="ticker__track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="ticker__group">
        {items.map((it) => <span class="ticker__item">{it}<i></i></span>)}
      </div>
    ))}
  </div>
</div>

<style>
  .ticker { overflow: clip; border-block: 1px solid var(--c-line-dark); padding-block: clamp(18px, 2.4vw, 30px); }
  .ticker__track { display: flex; width: max-content; animation: ticker 48s linear infinite; }
  .ticker:hover .ticker__track { animation-play-state: paused; }
  .ticker__group { display: flex; flex: none; }
  .ticker__item {
    display: inline-flex; align-items: center; gap: clamp(20px, 3vw, 44px); padding-right: clamp(20px, 3vw, 44px);
    font-size: clamp(1.75rem, 1rem + 3vw, 4rem); font-weight: 800; font-stretch: 72%; text-transform: uppercase; line-height: 1;
    color: transparent; -webkit-text-stroke: 1px rgb(255 255 255 / 0.55);
  }
  .ticker__item:nth-child(odd) { color: var(--c-white); -webkit-text-stroke: 0; }
  .ticker__item i { width: 10px; height: 10px; background: var(--c-accent); flex: none; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }
</style>
