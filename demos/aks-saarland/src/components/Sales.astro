---
import { home } from '../content/home';
import { site } from '../config/site';
import { homePath, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const s = home[lang].sales;

/* Pictogrammes techniques, un par famille (traits seulement) */
const icons = [
  // Agrartechnik : herse à disques
  `<path d="M14 54h132M30 54l-6 22M62 54l-6 22M94 54l-6 22M126 54l-6 22"/>${[24, 56, 88, 120].map((x) => `<ellipse cx="${x}" cy="96" rx="9" ry="20" transform="rotate(-18 ${x} 96)"/>`).join('')}<path d="M146 54l10-18h-24"/>`,
  // Erntetechnik : balle ronde
  `${[62, 48, 34, 20, 7].map((r, i) => `<circle cx="${80 + i * 1.6}" cy="80" r="${r}"/>`).join('')}<path d="M80 18v-8M128 32l6-6M142 80h8"/>`,
  // Lader : chargeur télescopique (flèche levée, fourche)
  `<rect x="34" y="100" width="108" height="20" rx="3"/><path d="M50 100V72h26l6 28"/><path d="M134 98L46 52l-4 8 88 46z"/><rect x="28" y="36" width="9" height="40" rx="1"/><path d="M28 74H6v5h22"/><circle cx="58" cy="132" r="14"/><circle cx="118" cy="132" r="14"/><circle cx="58" cy="132" r="5"/><circle cx="118" cy="132" r="5"/>`,
  // Forsttechnik : grume couchée, cernes et écorce
  `<path d="M40 54H128A14 30 0 0 1 128 114H40"/><ellipse cx="40" cy="84" rx="14" ry="30"/><ellipse cx="40" cy="84" rx="9" ry="20"/><ellipse cx="40" cy="84" rx="4" ry="9"/><path d="M64 66h44M74 82h48M60 98h40M88 110h30"/><path d="M118 40l14-14M126 46l20-6"/>`,
];
---
<section class="sales theme-dark" id="maschinen" data-nav-theme="dark" aria-labelledby="maschinen-title">
  <div class="container sales__head section">
    <p class="eyebrow" data-reveal>{s.eyebrow}</p>
    <div class="sales__head-grid">
      <h2 class="h" id="maschinen-title" data-split>
        {s.title.map((l) => <span class="mask"><span class="mask__inner">{l}</span></span>)}
      </h2>
      <p class="lead" data-reveal>{s.lead}</p>
    </div>
  </div>

  <div class="sales__pin" data-hscroll>
    <ol class="sales__track" data-hscroll-track>
      {s.panels.map((p, i) => (
        <li class="panel">
          <div class="panel__top">
            <span class="panel__index mono">{String(i + 1).padStart(2, '0')} / {String(s.panels.length).padStart(2, '0')}</span>
            <svg class="panel__icon" viewBox="0 0 160 160" aria-hidden="true" set:html={icons[i]} />
          </div>
          <h3 class="panel__title">{p.title}</h3>
          <p class="panel__text">{p.text}</p>
          <ul class="panel__brands">
            {p.brands.map((b) => <li>{b}</li>)}
          </ul>
        </li>
      ))}
      <li class="panel panel--cta">
        <p class="panel__note">{s.note}</p>
        <p class="panel__links">
          {site.listings.map((l) => <a class="link-line" href={l.url} target="_blank" rel="noopener">{l.name} ↗</a>)}
        </p>
        <a class="btn" href={`${homePath(lang)}#anfrage`} data-prefill="buy" data-magnetic>
          <span class="btn__label">{s.cta}</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </li>
    </ol>
    <div class="sales__progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </div>
</section>

<style>
  .sales { overflow: clip; }
  .sales__pin { scroll-padding-inline: var(--gutter); }
  .sales__head { padding-bottom: clamp(40px, 5vw, 72px); }
  .sales__head-grid { margin-top: 20px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px 64px; align-items: end; }
  .sales { padding-bottom: var(--section-y); }
  .sales__pin { position: relative; }
  .sales__track {
    display: flex; gap: 20px; width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--max-w)) / 2));
  }
  .panel {
    position: relative; flex: 0 0 auto; width: min(560px, 82vw); min-height: 520px;
    display: flex; flex-direction: column; gap: 20px;
    padding: clamp(24px, 2.6vw, 40px);
    background: var(--c-carbon); border: 1px solid var(--c-line-dark); border-radius: var(--r-container);
  }
  .panel::before, .panel::after { content: ''; position: absolute; width: 14px; height: 14px; border-color: var(--c-accent); border-style: solid; opacity: 0.8; }
  .panel::before { left: 12px; top: 12px; border-width: 1px 0 0 1px; }
  .panel::after { right: 12px; bottom: 12px; border-width: 0 1px 1px 0; }
  .panel__top { display: flex; justify-content: space-between; align-items: flex-start; }
  .panel__index { color: var(--c-stone); }
  .panel__icon { width: clamp(110px, 12vw, 160px); height: auto; fill: none; stroke: rgb(255 255 255 / 0.7); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .panel__title { margin-top: auto; font-size: clamp(2.25rem, 1.4rem + 2.4vw, 3.75rem); line-height: 0.9; font-weight: 820; font-stretch: 72%; text-transform: uppercase; }
  .panel__text { color: var(--c-stone); max-width: 42ch; min-height: calc(1.6em * 3); }
  .panel__brands { display: flex; flex-wrap: wrap; gap: 8px; }
  .panel__brands li { padding: 7px 11px; border: 1px solid var(--c-line-dark-strong); border-radius: var(--r-btn); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; }
  .panel--cta { background: transparent; border-style: dashed; justify-content: flex-end; align-items: flex-start; gap: 28px; width: min(420px, 82vw); }
  .panel--cta::before, .panel--cta::after { display: none; }
  .panel__note { font-size: var(--fs-sub); line-height: 1.3; font-weight: 500; color: var(--c-white); max-width: 22ch; }
  .panel__links { display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: var(--fs-small); color: var(--c-white); }
  .sales__progress { margin: 40px auto 0; width: min(240px, 50vw); height: 2px; background: var(--c-line-dark); display: none; }
  .sales__progress span { display: block; height: 100%; background: var(--c-brand); transform: scaleX(0); transform-origin: left; }
  :global(html.js-motion) .sales__progress { display: block; }

  /* Sans défilement horizontal piloté (mobile, sans JS) : défilement natif */
  @media (max-width: 960px) {
    .sales__head-grid { grid-template-columns: 1fr; }
    .sales__pin { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .sales__pin::-webkit-scrollbar { display: none; }
    .panel { scroll-snap-align: start; min-height: 440px; }
    .sales__track { gap: 12px; }
    .sales__progress { display: none !important; }
  }
  :global(html:not(.js-motion)) .sales__pin { overflow-x: auto; }
</style>
