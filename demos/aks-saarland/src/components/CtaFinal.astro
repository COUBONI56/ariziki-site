---
import { site } from '../config/site';
import { home } from '../content/home';
import { homePath, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = home[lang].cta;
---
<section class="cta theme-paper" data-nav-theme="dark" aria-labelledby="cta-title">
  <div class="cta__panel theme-dark" data-cta-panel>
    <div class="cta__beam" aria-hidden="true" data-cta-beam></div>
    <div class="container cta__inner">
      <h2 class="display cta__title" id="cta-title" data-split>
        {c.title.map((l) => <span class="mask"><span class="mask__inner">{l}</span></span>)}
      </h2>
      <div class="cta__foot">
        <p class="lead" data-reveal>{c.lead}</p>
        <div class="cta__actions" data-reveal>
          <a class="btn" href={site.phone.href} data-magnetic>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor"/></svg>
            <span class="btn__label">{c.call} · {site.phone.display}</span>
          </a>
          <a class="btn btn--ghost" href={`${homePath(lang)}#anfrage`}><span class="btn__label">{c.request}</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding: 0; }
  .cta__panel { position: relative; overflow: clip; min-height: 92vh; display: flex; align-items: center; padding-block: clamp(96px, 12vw, 180px); isolation: isolate; }
  .cta__beam {
    position: absolute; z-index: -1; right: -10%; top: 50%; width: 80vmax; height: 80vmax; translate: 0 -50%;
    background: conic-gradient(from 200deg at 50% 50%, transparent 0deg, rgb(var(--c-accent-rgb) / 0.18) 22deg, transparent 44deg, transparent 360deg);
    border-radius: 50%; filter: blur(2px);
    animation: sweep 7s linear infinite;
  }
  .cta__beam::after { content: ''; position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; translate: -50% -50%; border-radius: 3px; background: var(--c-accent); box-shadow: 0 0 60px 20px rgb(var(--c-accent-rgb) / 0.45); }
  @keyframes sweep { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .cta__beam { animation: none; } }
  .cta__inner { display: grid; gap: clamp(36px, 5vw, 72px); }
  .cta__title { max-width: 16ch; font-size: clamp(3rem, 1rem + 6vw, 7.5rem); }
  .cta__foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 960px) { .cta__panel { min-height: 0; } .cta__beam { right: -60%; } }
</style>
